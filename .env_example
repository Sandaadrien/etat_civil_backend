# Application
BETTER_AUTH_SECRET: "replace_with_a_long_random_secret"
BETTER_AUTH_URL: "http://localhost:3000"
OTP_HASH_SECRET: "replace_with_a_different_long_random_secret"

# SMTP
SMTP_HOST: "smtp.example.com"
SMTP_PORT: "587"
SMTP_SECURE: "false"
SMTP_USER: "replace_with_smtp_username"
SMTP_PASSWORD: "replace_with_smtp_password"
SMTP_FROM: "Enrolment Application <no-reply@example.com>"

# Database connection used by the API container.
# Keep the password in this URL synchronized with POSTGRES_PASSWORD below.
DATABASE_URL: "postgresql://etat_civil:replace_with_url_safe_password@postgres-db:5432/etat_civil?schema=public"

# Docker Compose
NODE_IMAGE: "node:22-alpine"
POSTGRES_IMAGE: "postgres:18-alpine"
NODE_ENV: "production"
APP_PORT: "3000"
API_PORT: "3000"
POSTGRES_PORT: "5432"
POSTGRES_USER: "etat_civil"
POSTGRES_PASSWORD: "replace_with_url_safe_password"
POSTGRES_DB: "etat_civil"
DATABASE_DUMP_PATH: "./etat_civil.sql"
API_CONTAINER_NAME: "etat-civil-api"
POSTGRES_CONTAINER_NAME: "etat-civil-postgres"
